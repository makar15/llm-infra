# ─────────────────────────────────────────────────────────────
# LLMProxy / LLMProjects — пример .env
# Скопируй: cp .env.example .env  и заполни своими значениями.
# НИКОГДА не коммить .env (он в .gitignore).
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
LANGFUSE_DB=langfuse
LITELLM_DB=litellm

# ── ClickHouse ────────────────────────────────
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me-strong-password
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# Должен совпадать с CLICKHOUSE_USER/CLICKHOUSE_PASSWORD выше
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:change-me-strong-password@clickhouse:9000/langfuse

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=change-me-strong-password
REDIS_PORT=6379

# ── MinIO ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-strong-password
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_LANGFUSE_BUCKET=langfuse
MINIO_REGION=us-east-1

# ── Langfuse ──────────────────────────────────
LANGFUSE_WEB_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Сгенерируй своё: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32

# Сгенерируй своё: openssl rand -base64 32
LANGFUSE_SALT=replace-with-openssl-rand-base64-32

# Ровно 64 hex-символа: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-must-be-exactly-64-hex-chars

# Опционально: автосоздание организации/проекта/пользователя при первом старте
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# Langfuse API-ключи проекта (создаются в UI: Settings → API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LANGFUSE_BASE_URL=http://localhost:3000
# Адрес, по которому контейнеры (litellm, llmguard) видят Langfuse Web внутри docker-сети
LANGFUSE_HOST=http://langfuse-web:3000

# ── LiteLLM ───────────────────────────────────
LITELLM_PORT=4000
# Сгенерируй: openssl rand -hex 16   (используется как Bearer-токен для LiteLLM API)
LITELLM_MASTER_KEY=replace-with-openssl-rand-hex-16

# ── LLMGuard ──────────────────────────────────
LLMGUARD_PORT=8080

# ── OpenAI ────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key

# ── Anthropic (опционально) ───────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-replace-with-your-anthropic-api-key
