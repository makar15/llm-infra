# ── PostgreSQL ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432
LANGFUSE_DB=langfuse
LITELLM_DB=litellm

# ── ClickHouse ────────────────────────────────
CLICKHOUSE_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# clickhouse://<user>:<password>@<host>:<native_port>/<database>
CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:changeme@clickhouse:9000/langfuse

# ── Redis ─────────────────────────────────────
REDIS_PASSWORD=changeme
REDIS_PORT=6379

# ── MinIO ─────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
MINIO_LANGFUSE_BUCKET=langfuse
MINIO_REGION=us-east-1

# ── Langfuse ──────────────────────────────────
LANGFUSE_WEB_PORT=3000
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# Generate with: openssl rand -base64 32
LANGFUSE_NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
LANGFUSE_SALT=replace-with-openssl-rand-base64-32

# Must be exactly 64 hex chars: openssl rand -hex 32
LANGFUSE_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32-must-be-exactly-64-hex-chars

# Optional: auto-seed org/project/user on first start
LANGFUSE_INIT_ORG_ID=
LANGFUSE_INIT_ORG_NAME=
LANGFUSE_INIT_PROJECT_ID=
LANGFUSE_INIT_PROJECT_NAME=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=
